# ===========================================================================
# .env.example — Variables de Entorno para PulmoSeg-3D (Docker)
#
# INSTRUCCIONES:
#   1. Copiar este archivo como .env en la raíz del proyecto:
#        cp .env.example .env
#   2. Configurar los valores según el entorno (desarrollo / producción)
#   3. NUNCA subir .env a control de versiones (está en .gitignore)
#
# Para generar una API Key segura:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ===========================================================================


# ===========================================================================
# SEGURIDAD — API Key compartida entre backend y frontend
# ===========================================================================
# Valor del header X-API-Key requerido para acceder a archivos médicos.
# DEBE ser idéntica en backend (PULMOSEG_API_KEY) y frontend (VITE_API_KEY).
# En producción: usar un valor aleatorio de al menos 32 bytes hex.
PULMOSEG_API_KEY=dev-pulmoseg-key-changeme-in-production


# ===========================================================================
# CORS — Orígenes permitidos para el backend FastAPI
# ===========================================================================
# Lista de orígenes HTTP permitidos, separados por coma (sin espacios).
#
# Desarrollo local (sin Docker):
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Docker local (Nginx en puerto 80):
#   CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173
#
# Producción (Google Cloud):
#   CORS_ORIGINS=https://pulmoseg.tudominio.com
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173


# ===========================================================================
# BASE DE DATOS — Ruta SQLite
# ===========================================================================
# Sin Docker (desarrollo local):
#   Omitir esta variable → usa el default: sqlite:///./local_jobs.db
#
# Con Docker (dentro del volumen montado):
#   DATABASE_URL=sqlite:////app/local_storage/local_jobs.db
#   (4 slashes = ruta absoluta en SQLite URL)
#
# Producción (GCP): Reemplazar por Cloud SQL (PostgreSQL)
#   DATABASE_URL=postgresql+asyncpg://user:password@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=sqlite:////app/local_storage/local_jobs.db


# ===========================================================================
# NOTAS PARA MIGRACIÓN A GOOGLE CLOUD PLATFORM
# ===========================================================================
# Al migrar de desarrollo local a GCP, las siguientes variables adicionales
# serán necesarias (descomentar y configurar):
#
# GCP_PROJECT_ID=tu-proyecto-gcp
# GCS_BUCKET_INPUTS=pulmoseg-inputs
# GCS_BUCKET_OUTPUTS=pulmoseg-outputs
# GCS_BUCKET_MODELS=pulmoseg-models
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

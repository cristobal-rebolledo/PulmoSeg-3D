# ===========================================================================
# .env.example — Plantilla de Entorno Local
#
# INSTRUCCIONES:
#   - Copia este archivo a ".env" para configurar tu entorno local.
#   - Este archivo SOLO ES VÁLIDO PARA DESARROLLO LOCAL (Docker o IDE).
#   - Cloud Run (Producción) no usa este archivo.
# ===========================================================================


# ===========================================================================
# SEGURIDAD — API Key compartida entre backend y frontend
# ===========================================================================
# Valor requerido para acceder a los endpoints en tu computador.
# En producción (GCP): Esto es ignorado. La API Key se lee de Secret Manager.
PULMOSEG_API_KEY=dev-pulmoseg-key-changeme-in-production


# ===========================================================================
# CORS — Orígenes permitidos para el backend FastAPI
# ===========================================================================
# Lista de orígenes HTTP permitidos, separados por coma (sin espacios).
#
# Desarrollo local (sin Docker):
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Docker local (Nginx en puerto 80):
#   CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173
#
# Producción (Google Cloud):
#   CORS_ORIGINS=https://pulmoseg.tudominio.com
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173


# ===========================================================================
# BASE DE DATOS LOCAL — Ruta SQLite
# ===========================================================================
# Sin Docker (desarrollo local):
#   Omitir esta variable → usa el default: sqlite:///./local_jobs.db
#
# Con Docker (dentro del volumen montado):
#   DATABASE_URL=sqlite:////app/local_storage/local_jobs.db
#   (4 slashes = ruta absoluta en SQLite URL)
#
#
# NOTA: En Producción (GCP Cloud Run) esta variable se ignora y se 
# inyecta la URL de PostgreSQL Cloud SQL en tiempo de despliegue.
DATABASE_URL=sqlite:////app/local_storage/local_jobs.db


# ===========================================================================
# NOTAS SOBRE GOOGLE CLOUD (PRODUCCIÓN)
# ===========================================================================
# La configuración de GCS (Buckets) y la conexión a Cloud SQL (PostgreSQL)
# no se configuran aquí. Se configuran directamente en los comandos de 
# despliegue (ej. gcloud run deploy --set-env-vars="GCS_BUCKET_INPUTS=...").

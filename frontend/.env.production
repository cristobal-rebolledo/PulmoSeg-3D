#   a Cloud Run. Esta variable se reemplaza con la URL real tras el despliegue.
#
# VITE_API_KEY: Debe coincidir con el secreto pulmoseg-api-key en Secret Manager.
#   Valor: 7c115781a953e2d3727829143d7def141f409547a09643bb446507fa27813e24
# ===========================================================================

# URL del backend Cloud Run — se actualiza tras obtener la URL del deploy
VITE_API_BASE_URL=https://pulmoseg-backend-827425626938.us-central1.run.app

# API Key de producción (coincide con el secreto pulmoseg-api-key en GCP)
VITE_API_KEY=7c115781a953e2d3727829143d7def141f409547a09643bb446507fa27813e24
